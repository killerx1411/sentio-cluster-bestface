# -----------------------------------------------------------------------------
# profilerecon — face recognition / attendance (Flask)
# -----------------------------------------------------------------------------

# Virtual environments (local Python installs; do not commit)
venv2/
AdaFace/

# AdaFace — cloned from https://github.com/mk-minchul/AdaFace.git (nested repo)
AdaFace/

# Python bytecode & caches
profilerecon/**/__pycache__/
profilerecon/**/*.py[cod]
profilerecon/**/.pytest_cache/

# Runtime / user data (generated at run time)
profilerecon/.embed_cache.pkl
profilerecon/profiles/
profilerecon/input_videos/

# Model weights (large binaries; place locally under weights/)
profilerecon/weights/
profilerecon/**/*.pth
profilerecon/**/*.ckpt

# Local secrets
profilerecon/.env
Frontend/.env
auth-backend/.env
LandingPage/.env

# -----------------------------------------------------------------------------
# profile-clustering + Best-Face combined pipeline
# -----------------------------------------------------------------------------

# Virtual environments
profile-clustering/clustervenv/
Best-Face/bestfaceharsh/
Best-Face/venv/
Best-Face/.venv/

# Python caches
profile-clustering/**/__pycache__/
Best-Face/**/__pycache__/

# Runtime data (videos, caches, exports)
profile-clustering/input_videos/
profile-clustering/cluster_profiles/
Best-Face/cluster_profiles/
Best-Face/face_registration/database/
Best-Face/test_output/
Best-Face/test_output.zip

# Generated pipeline bridge files
profile-clustering/**/*_detections.pkl
profile-clustering/**/*_clusters.json

# Model weights & large binaries
profile-clustering/AdaFace/
profile-clustering/weights/
profile-clustering/*.pt
profile-clustering/*.whl
profile-clustering/**/*.ckpt
profile-clustering/**/*.pth